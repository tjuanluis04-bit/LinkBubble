<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema por defecto de la app: forzado a modo claro. Lo usa la burbuja/panel/formulario
         flotantes (vía ContextThemeWrapper en BubbleService), así que se mantiene siempre
         consistente sin importar el modo oscuro del sistema. -->
    <style name="Theme.LinkBubble" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:textColorPrimary">#212121</item>
    </style>

    <!-- Tema de la pantalla principal (MainActivity): sigue el modo claro/oscuro del sistema. -->
    <style name="Theme.LinkBubble.Main" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <!-- Forzado a modo claro: su layout tiene fondo blanco fijo, igual que la burbuja. -->
    <style name="Theme.LinkBubble.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
